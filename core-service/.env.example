# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=datawow
DB_PASSWORD=changeme
DB_NAME=datawow_concert

# JWT — generate a strong secret: openssl rand -base64 32
JWT_SECRET=generate-a-random-secret-with-openssl-rand-base64-32
JWT_EXPIRES_IN=3600

# Redis (optional — falls back to in-memory cache if not set)
# Format: redis://:password@host:port
REDIS_URL=redis://:redis_secret@localhost:6379

# Kafka / Redpanda (optional — falls back to synchronous processing if not set)
KAFKA_BROKER=localhost:9092

# App
PORT=4000
NODE_ENV=development

# CORS — comma-separated origins (optional, defaults to localhost)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
